# URL publique du site (SEO, sitemap, Open Graph)
NUXT_PUBLIC_SITE_URL=https://www.oxynovardc.com

# Serveur Node (prod) — changer si 3000 est déjà pris
PORT=3001
HOST=0.0.0.0

# Admin
ADMIN_PASSWORD=Oxynova2026@
ADMIN_SECRET=changez-moi-en-production

# ——— Mail pro Hostinger ———
# En local : SMTP_* / IMAP_* suffisent (chargés au build / par Nuxt).
# En prod PM2 : préférez aussi les préfixes NUXT_ (override runtime), ex. :
#   NUXT_SMTP_HOST=smtp.hostinger.com
#   NUXT_SMTP_PORT=465
#   NUXT_SMTP_USER=...
#   NUXT_SMTP_PASS=...
#   NUXT_SMTP_FROM=...
#   NUXT_SMTP_TO=...
#   NUXT_IMAP_HOST=imap.hostinger.com
#   NUXT_IMAP_USER=...
#   NUXT_IMAP_PASS=...

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@oxynovardc.com
SMTP_PASS=votre-mot-de-passe-email
SMTP_FROM=contact@oxynovardc.com
SMTP_TO=contact@oxynovardc.com

IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=contact@oxynovardc.com
IMAP_PASS=votre-mot-de-passe-email
IMAP_MAILBOX=INBOX

# Si le port 465 est bloqué sur le VPS, essayez :
# SMTP_PORT=587
# SMTP_SECURE=false
